{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "tags": ["-knipignore"],
  "workspaces": {
    "apps/desktop": {
      "entry": [
        "src/main/main.ts",
        "src/overlay/cursor-overlay.ts",
        "src/overlay/cursor-overlay-preload.ts",
        "src/overlay/permission-overlay.ts",
        "src/overlay/permission-overlay-preload.ts",
        "src/overlay/pip.ts",
        "src/overlay/pip-preload.ts",
        "src/main/**/*.test.ts",
        "e2e/**/*.spec.ts",
        "scripts/browser-observe-act-smoke.mjs",
        "src/renderer/bridge/**/*.{ts,tsx}",
        "src/renderer/components/**/*.{ts,tsx}",
        "src/renderer/lib/**/*.{ts,tsx}",
        "src/renderer/locales/*.ts",
        "src/renderer/store/**/*.{ts,tsx}"
      ],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "scripts/**/*.mjs"],
      "ignoreBinaries": ["plutil", "pgrep"],
      "ignoreDependencies": [
        "@tiptap/extension-mention",
        "@tiptap/suggestion",
        "@types/katex",
        "fast-deep-equal",
        "mermaid",
        "partial-json",
        "tailwindcss",
        "throttleit",
        "tiptap-markdown"
      ],
      "ignoreUnresolved": ["../src/renderer/features/connection-settings"],
      "ignore": ["src/shared/session-local-contract.d.ts"]
    },
    "packages/ui": {
      "entry": ["src/index.ts", "src/**/*.test.ts", "src/**/*.test.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
