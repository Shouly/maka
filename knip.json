{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "tags": ["-knipignore"],
  "workspaces": {
    "apps/desktop": {
      "entry": [
        "src/main/main.ts",
        "src/overlay/cursor-overlay.ts",
        "src/overlay/cursor-overlay-preload.ts",
        "src/overlay/permission-overlay.ts",
        "src/overlay/permission-overlay-preload.ts",
        "src/overlay/pip.ts",
        "src/overlay/pip-preload.ts",
        "src/main/**/*.test.ts",
        "e2e/**/*.spec.ts",
        "scripts/browser-observe-act-smoke.mjs",
        "src/renderer/main.tsx",
        "src/renderer/lib/ported/**/*.{ts,tsx}",
        "src/renderer/locales/*.ts"
      ],
      "project": ["src/**/*.{ts,tsx}", "e2e/**/*.ts", "scripts/**/*.mjs"],
      "ignoreBinaries": ["plutil", "pgrep"],
      "ignoreDependencies": [
        "@radix-ui/react-dialog",
        "@radix-ui/react-dropdown-menu",
        "@radix-ui/react-popover",
        "@radix-ui/react-scroll-area",
        "@radix-ui/react-select",
        "@radix-ui/react-slot",
        "@radix-ui/react-switch",
        "@radix-ui/react-toast",
        "@radix-ui/react-tooltip",
        "@tiptap/core",
        "@tiptap/extension-mention",
        "@tiptap/extension-placeholder",
        "@tiptap/pm",
        "@tiptap/react",
        "@tiptap/starter-kit",
        "@tiptap/suggestion",
        "@types/katex",
        "@types/prismjs",
        "@xterm/addon-fit",
        "@xterm/xterm",
        "avvvatars-react",
        "clsx",
        "fast-deep-equal",
        "katex",
        "mermaid",
        "motion",
        "partial-json",
        "prismjs",
        "react-markdown",
        "rehype-katex",
        "rehype-raw",
        "remark-gfm",
        "remark-math",
        "tailwind-merge",
        "tailwindcss",
        "throttleit",
        "tiptap-markdown",
        "zustand"
      ],
      "ignoreUnresolved": ["../src/renderer/features/connection-settings"]
    },
    "packages/ui": {
      "entry": ["src/index.ts", "src/**/*.test.ts", "src/**/*.test.tsx"],
      "project": ["src/**/*.{ts,tsx}"]
    }
  }
}
