{
  "name": "@maka/server",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "The Maka organization server: sign-in, the model gateway and the admin console.",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "node ../../scripts/clean-paths.mjs dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json",
