    "start": "node dist/main.js",
    "test:dist": "node --test \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@anthropic-ai/vertex-sdk": "^0.19.11",
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@maka/platform-protocol": "0.1.0",
    "fastify": "^5.12.5",
    "google-auth-library": "^10.9.1",
    "jose": "^6.2.3",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@types/pg": "^8.23.1"
  }
}
