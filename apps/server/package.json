{
  "name": "@maka/server",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "The Maka organization server: sign-in, the model gateway and the admin console.",
  "type": "module",
  "private": true,
  "scripts": {
    "clean": "node ../../scripts/clean-paths.mjs dist tsconfig.tsbuildinfo",
    "build": "tsc -p tsconfig.json && npm run build:console",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p console/tsconfig.json",
    "start": "node dist/main.js",
    "test:dist": "node --test \"dist/**/*.test.js\"",
    "build:console": "tsc -p console/tsconfig.json && vite build --config console/vite.config.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@anthropic-ai/vertex-sdk": "^0.19.11",
    "@fastify/cookie": "^11.1.2",
    "@fastify/formbody": "^9.0.0",
    "@maka/platform-protocol": "0.1.0",
    "fastify": "^5.12.5",
    "google-auth-library": "^10.9.1",
    "jose": "^6.2.3",
    "kysely": "^0.29.6",
    "pg": "^8.23.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@maka/core": "0.1.0",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-switch": "^1.3.7",
    "@radix-ui/react-toast": "^1.2.23",
    "@tailwindcss/vite": "^4.3.3",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/xterm": "^6.0.0",
    "clsx": "^2.1.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "simple-icons": "16.29.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  }
}
